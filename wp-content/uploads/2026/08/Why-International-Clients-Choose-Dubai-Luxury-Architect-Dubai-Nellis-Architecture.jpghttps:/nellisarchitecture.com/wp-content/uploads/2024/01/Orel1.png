<body id="body">
  <h1 class="visually-hidden">How Dubai Climate Shapes Every Decision a Luxury Architect Makes</h1>
  <input type="hidden" id="nonce" value="9f24efdeb8">
  <div class="modalBG">
    <div class="modalWindow">
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <path
          d="M1 1L13 13M13 1L1 13"
          stroke="#00372A"
          stroke-linecap="round" />
      </svg>

      <h2 class="formName">Have a project?</h2>
      <div class="formDescr">Please take a moment to complete the form below.</div>
      <form class="projectForm" id="yourFormId" method="POST" action="https://nellisarchitecture.com/wp-admin/admin-ajax.php">
        <input type="hidden" name="action" value="callback_form1">
        <input
          type="text"
          name="name"
          class="name"
          placeholder="Name"
          required />
        <input
          type="email"
          name="email"
          class="email"
          placeholder="E-mail *"
          required />
        <input
          type="tel"
          name="phone"
          class="phoneNumber"
          placeholder="Phone number"
          required />
        <textarea
          name="massage"
          id="massage"
          class="massage"
          placeholder="Your message *"></textarea>


        <img src="https://nellisarchitecture.com/wp-content/themes/nellis/captcha.php" alt="">
        <input type="text" name="kapcha" required />


        <div class="policyLink">
          By submitting this form, I consent to the
          <a href="/pravicy" target="_blank">Privacy Policy.</a>
        </div>
        <button type="submit">Send message</button>
      </form>
      <div class="underForm">
        or send us an email to:
        <a href="mailto:hello@nellisarchitecture.com">hello@nellisarchitecture.com</a>
      </div>
    </div>
  </div>
  <div class="modalBG2">
    <div class="modalWindow2">
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <path
          d="M1 1L13 13M13 1L1 13"
          stroke="#00372A"
          stroke-linecap="round" />
      </svg>

      <h2 class="formName">Got skills?</h2>
      <div class="formDescr">Please take a moment to complete the form below.</div>
      <form id="yourFormId2" class="projectForm" method="POST" action="https://nellisarchitecture.com/wp-admin/admin-ajax.php">
        <input type="hidden" name="action" value="callback_form1">
        <input
          type="text"
          name="name"
          class="name"
          placeholder="Name"
          required />
        <input
          type="email"
          name="email"
          class="email"
          placeholder="E-mail *"
          required />
        <input
          type="tel"
          name="phone"
          class="phoneNumber"
          placeholder="Phone number"
          required />
        <textarea
          name="massage"
          id="massage2"
          class="massage"
          placeholder="Your message *"
          required></textarea>

        <div class="dragWindow">
          <input id="file-input" type="file" accept=".gif,.jpg,.jpeg,.png,.doc,.docx,.pdf" name="files[]" multiple />

          <div class="loadingFile">
            <div class="loadingFile__img"></div>
            <div class="loadingFile__scrollContainer">
