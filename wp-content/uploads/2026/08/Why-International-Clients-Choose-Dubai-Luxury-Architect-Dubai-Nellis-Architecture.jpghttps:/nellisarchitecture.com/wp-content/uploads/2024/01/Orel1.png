      <style>
        .arrowUp {
          transition: 0.8s;
        }
        html {
          box-sizing: border-box;
          scroll-behavior: smooth;
          overflow: hidden;
        }
        body {
          height: 100vh;
          overflow: hidden;
          margin: 0;
          background: #fbfdfd;
          font-family: "Switzer", sans-serif;
          font-weight: 400;
          font-size: 16px;
          color: var(--col-green);
        }
        .footer__container {
          /* transform: translateY(-100%); */
          margin-left: 0 !important;
        }
        @media screen and (max-width: 760px) {
          body {
            overflow-y: auto;
            position: relative;
          }
        }
        .footer {
          transform: translateY(-240px);
          margin-left: 0;
        }
        @media screen and (max-width: 1440px) {
          .footer {
            transform: translateY(-200px);
          }
        }
        @media screen and (max-width: 1179px) {
          .footer {
            transform: translateY(0px);
          }
        }
        .projectPage {
          color: #002e20;
          list-style: disc;
          margin-left: 16px;
        }
      </style>
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          let WIDTH2 = window.innerWidth;
          let mobile = false;
          if (WIDTH2 <= 769) {
            mobile = true;
          } else {
            mobile = false;
          }
          window.addEventListener("resize", () => {
            WIDTH2 = window.innerWidth;
            if (WIDTH2 <= 769) {
              mobile = true;
            } else {
              mobile = false;
            }
          });
          const Contect = document.querySelector(".contactPage");
          const burger = document.querySelector(".burger");
          const centerProjectScroll = document.querySelector(".centerProject");
          const burMenuMob = document.querySelector(".burMenuMob");
          Contect.addEventListener("click", () => {
            if (!mobile) {
              centerProjectScroll.scroll({
                top: centerProjectScroll.scrollHeight,
                behavior: "smooth",
              });
            } else {
              burger.click();
              document.querySelector("body").scroll({
                top: document.querySelector("body").scrollHeight,
                behavior: "smooth",
              });
            }
            if (window.innerWidth <= 1179 && window.innerWidth >= 770) {
              burger.click();
            }
          });

          const categoryLink = document.querySelectorAll(
            ".nav__project_item a"
          );
          categoryLink.forEach((el) => {
            el.addEventListener("click", () => {
              for (let i = 0; i < categoryLink.length; i++) {
                categoryLink[i].classList.remove("categoryActive");
              }
              el.classList.add("categoryActive");
            });
          });
        });
      </script>
