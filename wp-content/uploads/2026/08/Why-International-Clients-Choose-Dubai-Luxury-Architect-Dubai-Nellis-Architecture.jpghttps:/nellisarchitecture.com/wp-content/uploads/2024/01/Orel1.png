<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('yourFormId');
    form.addEventListener('submit', function(event) {
        event.preventDefault();
        var formData = new FormData(form);
        formData.append('action', 'callback_form1'); 
        // formData.append('security', document.getElementById('nonce').value);
        console.log('formData:', formData);
        for (var pair of formData.entries()) {
            console.log(pair[0] + ': ' + pair[1]);
        }
        var xhr = new XMLHttpRequest();
        xhr.open('POST', 'https://nellisarchitecture.com/wp-admin/admin-ajax.php', true);
        xhr.onreadystatechange = function() {
            if (xhr.readyState === 4) {
                if (xhr.status === 200) {
                    var response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        alert(response.data);
                    } else {
                        alert(response.data);
                    }
                } else {
                    alert('Error.');
                }
            }
        };
        xhr.send(formData);
    });
});
</script>



<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('yourFormId2');
    const loadingFileLabels = document.querySelectorAll(".loadingFile");
    form.addEventListener('submit', function(event) {
        event.preventDefault();
        
        var formData = new FormData(form);
        formData.append('action', 'callback_form2');
      
        formData.append('security', document.getElementById('nonce').value);
        
        var xhr = new XMLHttpRequest();
        xhr.open('POST', 'https://nellisarchitecture.com/wp-admin/admin-ajax.php', true);
        
        xhr.upload.onprogress = function(event) {
            if (event.lengthComputable) {
                var percentComplete = (event.loaded / event.total) * 100;
                console.log('loading: ' + Math.round(percentComplete) + '%');
            }
        };
        
        xhr.onreadystatechange = function() {
            if (xhr.readyState === 4) {
                if (xhr.status === 200) {
                    var response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        alert(response.data);
                        loadingFileLabels.forEach(element => {
                          element.style.display = 'none';
                        });
                    } else {
                        alert(response.data);
                    }
                } else {
                    alert('Error when submitting the form.');
                }
            }
        };
        
        xhr.send(formData);
    });
});
</script>

    <script>
Fancybox.bind("[data-fancybox]", {
    hash: false
});
    </script>

</body>
</html>