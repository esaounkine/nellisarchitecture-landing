{
  "name": "nellis-architecture-static",
  "version": "1.0.0",
  "private": true,
  "description": "Static build of nellisarchitecture.com with Decap CMS for news",
  "scripts": {
    "build": "node build-news.js",
    "serve": "serve -l 8000",
    "lint": "eslint .",
