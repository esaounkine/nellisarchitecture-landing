    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "globals": "^17.13.0",
    "serve": "^14.2.6",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=20"
  }
}
